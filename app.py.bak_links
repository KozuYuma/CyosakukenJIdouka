        expanded=st.session_state.project_id is None,
    ):
        _projects = list_projects()

        _pm_col1, _pm_col2 = st.columns(2)

        # 新規作成
        with _pm_col1:
            st.markdown("**新規プロジェクト**")
            _new_name = st.text_input(
                "プロジェクト名",
                placeholder="例: ◯◯劇場版 BGM調査",
