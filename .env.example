# このファイルをコピーして .env を作り、値を埋めてください。
#   copy .env.example .env
# .env は .gitignore 済みなので GitHub には上がりません。

# ── DB接続先 ─────────────────────────────────────────
# 空欄またはこの行ごと削除 → 従来どおりローカルの SQLite（data/cyosakuken.db）
# Supabase を使う場合は「Session pooler」の接続文字列を貼る。
#   Supabase → プロジェクト → Connect → Session pooler → URI
#   末尾の [YOUR-PASSWORD] を実際のパスワードに置き換えること。
DATABASE_URL=

# ── MINC ログイン（既存）────────────────────────────
# MINC_ID=
# MINC_PASSWORD=
