# このファイルをコピーして .env を作り、値を埋めてください。
#   copy .env.example .env
# .env は .gitignore 済みなので GitHub には上がりません。

# ── DB接続先 ─────────────────────────────────────────
# 空欄またはこの行ごと削除 → 従来どおりローカルの SQLite（data/cyosakuken.db）
# Supabase を使う場合は「Session pooler」の接続文字列を貼る。
#   Supabase → プロジェクト → Connect → Session pooler → URI
#   末尾の [YOUR-PASSWORD] を実際のパスワードに置き換えること。
DATABASE_URL=

# ── アプリのログイン ────────────────────────────────
# 「名前:合言葉」をカンマ区切りで並べる。合言葉は人ごとに変えること。
#   APP_USERS=ゆま:合言葉1,たろう:合言葉2
#
# 空欄またはこの行ごと削除 → ログイン画面を出さない（手元で使う場合）。
# 設定すると:
#   * 起動時にログイン画面が出る
#   * 案件はログインした人ごとに分かれ、他人のものは一覧に出ない
#   * 所有者が付いていない案件（分ける前のもの）は全員に見え、
#     読み込んだ人のものになる
# 人が増減したらこの行を書き換えるだけ。登録画面もユーザー表も不要。
APP_USERS=

# ── MINC ログイン（既存）────────────────────────────
# MINC_ID=
# MINC_PASSWORD=
